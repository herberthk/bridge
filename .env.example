# ─────────────────────────────────────────────────────────────────────────────
# Bridge — environment configuration
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Project settings → General → Your apps → Web app) ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account JSON for the Admin SDK (Project settings → Service accounts
# → Generate new private key). Paste it ONE of these ways:
#   1. Whole multi-line JSON wrapped in single quotes (see below), or
#   2. The JSON on a single line (newlines removed), or
#   3. The JSON base64-encoded.
# NOTE: a raw multi-line paste WITHOUT quotes will NOT parse.
# Fallback alternative: set FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL +
# FIREBASE_PRIVATE_KEY (with \n escapes) instead.
FIREBASE_SERVICE_ACCOUNT_KEY=''

# Point the client + admin SDKs at local emulators (true/false).
# Run emulators with: npx -y firebase-tools@latest emulators:start
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
FIREBASE_EMULATOR_HOST=localhost

# ── Google Gemini (https://aistudio.google.com/apikey) ──────────────────────
# The AI SDK reads GOOGLE_GENERATIVE_AI_API_KEY automatically.
GOOGLE_GENERATIVE_AI_API_KEY=

# Model overrides (defaults shown). Live/voice model must support the
# Gemini Live API.
BRIDGE_MODEL_TEXT=gemini-3.6-flash
BRIDGE_MODEL_TEXT_PRO=gemini-3.1-pro-preview
BRIDGE_MODEL_LIVE=gemini-live-2.5-flash-native-audio
BRIDGE_MODEL_SNAPSHOT=gemini-3.5-flash-lite

# ── Platform ────────────────────────────────────────────────────────────────
# Canonical URL of the deployed app (used in emails, PWA manifest).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key guarding the one-time /setup page that creates the first
# Super Admin. Generate e.g. with: bun -e "console.log(crypto.randomUUID())"
SETUP_ADMIN_KEY=

# Shared secret guarding internal API routes (/api/internal/*). The Cloud
# Functions sweeper sends it as the x-internal-secret header. Use a long
# random value — same generator command as above.
INTERNAL_API_SECRET=

# ── Email (SMTP) for nodemailer — used for invites, results, notices ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Bridge <no-reply@bridge.example>"
